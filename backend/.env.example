# ============================================================================
# .env.example - copy to ".env" and fill in. NEVER commit the real ".env".
# The app validates every value at startup and refuses to run if one is wrong.
# ============================================================================

# development | test | production
NODE_ENV=development

# Port the API listens on
PORT=4000

# Public address of the website (used in email links later).
# Development: the frontend address. Production: https://learn.yourdomain.org
APP_URL=http://localhost:3000

# Browsers allowed to call the API from a different address (comma separated).
# Needed in development (frontend :3000 -> API :4000). Leave empty in production
# when the website and API share one address behind Caddy.
CORS_ORIGINS=http://localhost:3000

# Database + Redis (these match docker-compose.yml)
DATABASE_URL=postgresql://gsg:gsg_dev_password@localhost:5432/gsg_lms?schema=public
REDIS_URL=redis://localhost:6379

# Secret used to sign session cookies (Batch 3). At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Database used ONLY by automated database tests (npm run test:db).
# It must end in "_test" - the tests refuse to run otherwise, so they can
# never wipe your development data. Create it once with:
#   docker exec gsg_postgres psql -U gsg -d postgres -c "CREATE DATABASE gsg_lms_test;"
TEST_DATABASE_URL=postgresql://gsg:gsg_dev_password@localhost:5432/gsg_lms_test?schema=public

# Public "apply to become an instructor" form: true | false (default false).
# Instructor accounts are ALWAYS created by an admin either way.
INSTRUCTOR_APPLICATIONS_ENABLED=false

# trace | debug | info | warn | error
LOG_LEVEL=debug


