# ----------------------------------------------------------------------------
# Real email sending (optional). Leave SMTP_HOST empty to keep emails in the
# outbox only (in development their links are printed in the terminal).
# Any provider that offers SMTP works: your host's mail, Resend, SendGrid,
# Mailgun, Amazon SES... Use the details the provider gives you.
# Then run the sender with:  npm run email:send
# ----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
# true for providers that use a secure connection from the start (usually port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# The "From" shown on every email, e.g.  Girls Set Go <no-reply@yourdomain.org>
MAIL_FROM=