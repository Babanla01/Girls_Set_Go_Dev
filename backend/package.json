{
  "name": "girls-set-go-lms-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Girls Set Go LMS - backend API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config ./test/jest.config.json --runInBand",
    "test:db": "jest --config ./test/jest.integration.config.json --runInBand",
    "test:all": "npm test && npm run test:db",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "admin:create": "npm run build --silent && node dist/cli/create-admin.js",
    "db:seed": "npm run build --silent && node dist/cli/seed.js",
    "retention:run": "npm run build --silent && node dist/cli/run-retention.js",
    "email:send": "npm run build --silent && node dist/cli/send-emails.js"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/throttler": "~6.5.0",
    "@prisma/client": "~6.19.3",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.2.1",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "~6.19.3",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "typescript": "~5.8.3"
  }
}