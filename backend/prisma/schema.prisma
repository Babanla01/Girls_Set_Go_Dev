// ============================================================================
// prisma/schema.prisma - Girls Set Go LMS database structure
//
// MERGED FILE = LMS core + course content/versions/progress/assignments
//               + file storage & student submissions + submission reviews
//               + activity log, badges & per-user settings
//               + WEB section (CMS pages, media library, platform settings,
//                 notifications, announcements, forms).
//
// This file describes the tables to Prisma (so the code is type-safe).
// The matching SQL lives in prisma/migrations/. A few rules that Prisma cannot
// express (CHECK rules, "partial" unique indexes, triggers) are written by hand
// in those SQL files - look for the "HAND-WRITTEN" sections.
//
// Conventions:
//  - Table/column names in the database are snake_case; code uses camelCase.
//  - IDs are random UUIDs (cannot be guessed or counted by outsiders).
//  - Every timestamp is stored WITH timezone (timestamptz).
//  - Users are never deleted - they are suspended. Foreign keys that point at
//    users use "Restrict" so history can never be orphaned by accident.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------- enums

/// What a person is. One email = one account = one role.
enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

/// Whether the account can sign in.
///  INVITED   : created by an admin, password not set yet (cannot sign in)
///  ACTIVE    : normal working account (must have a password)
///  SUSPENDED : switched off by an admin (history is kept)
enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// Why a one-time link exists.
enum AuthTokenType {
  INVITE
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum InstructorApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

/// Why an admin declined an application. INTERNAL: used for reporting only and
/// never shown to the student.
enum DeclineReason {
  NOT_ELIGIBLE
  COHORT_FULL
  INCOMPLETE_INFORMATION
  DUPLICATE_APPLICATION
  OTHER
}

/// A course copy is either the course's master TEMPLATE or one cohort's own COPY of it.
enum ContentKind {
  TEMPLATE
  COHORT_COPY
}

/// How a saved course version came to be: someone PUBLISHED the draft, or RESTOREd an older version.
enum VersionSource {
  PUBLISH
  RESTORE
}

/// Why a week is open for a student: her progress opened it, or an instructor / admin opened it early.
enum WeekUnlockSource {
  PROGRESS
  EARLY_OPEN
}

/// Where a student's submission stands. REVIEWED / NEEDS_REVISION / COMPLETED are set by an
/// instructor's review (next part of Batch 4).
enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  NEEDS_REVISION
  COMPLETED
}

/// Kinds of event in a student's activity log (append-only).
enum ActivityType {
  ENROLLED
  LESSON_COMPLETED
  SUBMISSION_SENT
  REVIEW_RECEIVED
  BADGE_EARNED
}

/// The six badges a student can earn.
enum BadgeKey {
  WELCOME_ABOARD
  FIRST_SUBMISSION
  ON_TIME
  FEEDBACK_LOOP
  HALFWAY_THERE
  SHOWCASE_READY
}

/// Whether a person's profile panel is open, collapsed to a thin rail, or closed (remembered per user).
enum PanelState {
  OPEN
  COLLAPSED
  CLOSED
}

/// What an instructor decides when reviewing a submission.
enum ReviewOutcome {
  REVIEWED
  NEEDS_REVISION
  COMPLETED
}

/// The kinds of block a lesson is built from.
enum BlockType {
  TEXT
  VIDEO
  ACTIVITY
  STEPS
  CALLOUT
  RESOURCE
}

/// A track is archived instead of deleted, so history is never lost.
enum TrackStatus {
  ACTIVE
  ARCHIVED
}

/// DRAFT = still being prepared; PUBLISHED = ready for students; ARCHIVED = retired.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// PLANNED = created but not started (students can already be accepted into it);
/// ACTIVE = running; CLOSED = finished or retired (nobody can be added or edited).
enum CohortStatus {
  PLANNED
  ACTIVE
  CLOSED
}

/// Where a student's application stands. Separate from the account status and
/// from enrollment: course access comes ONLY from an active enrollment.
enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// ACTIVE = in the cohort now; COMPLETED = finished the course (content stays readable);
/// TRANSFERRED = moved to another cohort or track; WITHDRAWN = left the programme.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

/// (WEB) Folders of the media library. The folder is the first part of an image's fixed key.
enum CmsMediaFolder {
  BRAND
  BANNERS
  SITE
  PEOPLE
  PROJECTS
  PRODUCTS
  VIDEOS
}

/// (WEB) DRAFT = being prepared, invisible to visitors; PUBLISHED = live on the website.
enum CmsContentStatus {
  DRAFT
  PUBLISHED
}

/// (WEB) Where a public profile appears: team (about page), instructor (cohort page) or both.
enum CmsPersonKind {
  TEAM
  INSTRUCTOR
  BOTH
}

/// (WEB) Where a video's picture and sound come from: a file uploaded here, or an embedded YouTube / Vimeo video.
enum CmsVideoSource {
  UPLOAD
  YOUTUBE
  VIMEO
}

/// (WEB) The Creative Studio categories. Every video has ONE primary category and may carry more tags.
enum CmsVideoCategory {
  UI_UX_PROJECTS
  AI_ROBOTICS
  STUDENT_STORIES
  BEHIND_THE_SCENES
}

/// (WEB) What a banner slide shows: a photo, or a muted looping video (with a photo until it loads).
enum CmsBannerMediaType {
  PHOTO
  VIDEO
}

/// (WEB) The website pages that have a banner. Each page picks its own slides.
enum CmsBannerPage {
  HOME
  COHORT_SHOWCASE
  CREATIVE_STUDIO
}

/// (WEB) Who an announcement is for: every cohort that is running or about to run, one track, or one cohort.
enum AnnAudienceType {
  ALL_COHORTS
  TRACK
  COHORT
}

/// (WEB) DRAFT = being written, nobody sees it; PUBLISHED = visible to its audience.
enum AnnStatus {
  DRAFT
  PUBLISHED
}

/// (WEB) The public forms whose messages are stored (the notify-me list has its own table).
enum FormSubmissionType {
  CONTACT
  VOLUNTEER
  PARTNER
}

/// (WEB) NEW = nobody has looked yet; READ = seen; ARCHIVED = dealt with.
enum FormSubmissionStatus {
  NEW
  READ
  ARCHIVED
}

/// (WEB) Whether an address on the notify-me list still wants emails.
enum FormNotifyMeStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

// -------------------------------------------------------------------- models

/// Every person who can sign in: students, instructors and admins.
model User {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always stored lowercase (the database enforces this).
  email           String        @unique @db.VarChar(254)
  fullName        String        @map("full_name") @db.VarChar(120)
  /// Argon2id hash. Empty while an invited user has not chosen a password yet.
  passwordHash    String?       @map("password_hash")
  role            Role
  status          AccountStatus
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(3)
  /// When the person proved the address is theirs (by clicking the emailed link). Null = not yet.
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  /// The admin who created this account (instructors/admins). Null for self sign-up.
  createdById     String?       @map("created_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy                   User?                   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers                User[]                  @relation("UserCreatedBy")
  sessions                    Session[]
  authTokens                  AuthToken[]
  auditLogs                   AuditLog[]
  reviewedInstructorApps      InstructorApplication[] @relation("ApplicationReviewedBy")
  /// Set when this account was created by approving an instructor application.
  instructorApplication       InstructorApplication?  @relation("ApplicationCreatedUser")
  tracksCreated               Track[]                 @relation("TrackCreatedBy")
  coursesCreated              Course[]                @relation("CourseCreatedBy")
  cohortsCreated              Cohort[]                @relation("CohortCreatedBy")
  /// The cohorts this person teaches (only meaningful for instructors).
  cohortAssignments           CohortInstructor[]      @relation("CohortInstructorUser")
  cohortAssignmentsMade       CohortInstructor[]      @relation("CohortAssignedBy")
  studentProfile              StudentProfile?
  /// Her saved settings (for now: the profile panel).
  preference                  UserPreference?
  studentApplication          StudentApplication?     @relation("ApplicationStudent")
  studentApplicationsReviewed StudentApplication[]    @relation("StudentApplicationReviewedBy")
  enrollments                 Enrollment[]            @relation("EnrollmentStudent")
  enrollmentsMade             Enrollment[]            @relation("EnrollmentCreatedBy")
  /// Course copies this person last edited.
  courseContentsEdited        CourseContent[]         @relation("ContentEditedBy")

  // --- relations: WEB (owner: WEB account - website editor, announcements, forms, shop, platform layer) ---
  cmsMediaCreated             CmsMediaAsset[]         @relation("CmsMediaCreatedBy")
  cmsPeopleCreated            CmsPerson[]             @relation("CmsPersonCreatedBy")
  /// The public profile of this instructor (if one was made).
  cmsPersonProfile            CmsPerson?              @relation("CmsPersonInstructor")
  platformSettingsUpdated     PlatformSetting[]       @relation("PlatformSettingUpdatedBy")
  cmsPagesCreated             CmsPage[]               @relation("CmsPageCreatedBy")
  cmsPagesEdited              CmsPage[]               @relation("CmsPageEditedBy")
  cmsPageVersionsPublished    CmsPageVersion[]        @relation("CmsPageVersionPublishedBy")
  cmsVideosCreated            CmsVideo[]              @relation("CmsVideoCreatedBy")
  cmsBannerSlidesCreated      CmsBannerSlide[]        @relation("CmsBannerSlideCreatedBy")
  platformNotifications       PlatformNotification[]  @relation("PlatformNotificationRecipient")
  annAnnouncementsAuthored    AnnAnnouncement[]       @relation("AnnAnnouncementAuthor")
  formSubmissionsHandled      FormSubmission[]        @relation("FormSubmissionHandledBy")
  // --- end relations: WEB ---

  @@index([role, status])
  @@map("users")
}

/// One row per signed-in device. Revoking a row logs that device out at once.
model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 of the session token. The raw token only ever lives in the cookie.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time links: instructor invites, password resets and email confirmations.
model AuthToken {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  /// SHA-256 of the token in the emailed link (never the token itself).
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  /// Set the moment the link is used. A used link can never work again.
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Permanent record of important actions. Append-only: the database refuses
/// to update or delete rows (see the HAND-WRITTEN section of the first migration).
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Who did it. Null means the system did it (for example a scheduled job).
  actorId    String?  @map("actor_id") @db.Uuid
  /// The role that person had at the time (filled in automatically).
  actorRole  Role?    @map("actor_role")
  /// What happened, e.g. "instructor.invited".
  action     String   @db.VarChar(100)
  /// What it happened to, e.g. "user", "instructor_application".
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// Extra detail. Never put passwords, tokens or personal details here.
  metadata   Json?
  /// What the thing looked like BEFORE and AFTER the change (small facts only,
  /// never personal details). Empty on older entries and on actions with no "change".
  previousValue Json?   @map("previous_value")
  newValue      Json?   @map("new_value")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Someone asking to become an instructor. NOT an account: the applicant has
/// no login. An admin may approve it, which creates an INVITED instructor user.
model InstructorApplication {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName       String                      @map("full_name") @db.VarChar(120)
  /// Always lowercase (enforced by the database).
  email          String                      @db.VarChar(254)
  phone          String                      @db.VarChar(30)
  expertise      String                      @db.VarChar(200)
  /// Which track they would like to teach (free text; optional).
  preferredTrack String?                     @map("preferred_track") @db.VarChar(100)
  bio            String                      @db.VarChar(2000)
  experience     String                      @db.VarChar(3000)
  /// Portfolio / LinkedIn / GitHub links. Links only - no file uploads.
  links          String[]
  motivation     String                      @db.VarChar(2000)
  availability   String                      @db.VarChar(500)
  status         InstructorApplicationStatus @default(PENDING)
  reviewedById   String?                     @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?                   @map("reviewed_at") @db.Timestamptz(3)
  /// Internal note for admins only. Never shown to the applicant.
  decisionNote   String?                     @map("decision_note") @db.VarChar(1000)
  /// The instructor account created from this application (when approved).
  createdUserId  String?                     @unique @map("created_user_id") @db.Uuid
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  reviewedBy  User? @relation("ApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  createdUser User? @relation("ApplicationCreatedUser", fields: [createdUserId], references: [id], onDelete: Restrict)

  // Used by the retention cleanup (declined applications deleted after 2 months).
  @@index([status, reviewedAt])
  @@index([email])
  @@map("instructor_applications")
}

/// Emails waiting to be sent. A row is written in the SAME database transaction
/// as the action that causes the email, so an email can never be lost or sent
/// for something that was rolled back. A background worker (later batch) sends them.
model EmailOutbox {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  toEmail       String      @map("to_email") @db.VarChar(254)
  /// Which template to use, e.g. "instructor-invite".
  template      String      @db.VarChar(100)
  /// Values for the template. May briefly hold a one-time link; the sender
  /// clears it after a successful send.
  payload       Json
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String?     @map("last_error") @db.VarChar(500)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  /// What this email is about, e.g. "student_application" + that application's id.
  /// Lets an admin see (and retry) the emails of one thing. Empty for unlinked emails.
  entityType    String?     @map("entity_type") @db.VarChar(50)
  entityId      String?     @map("entity_id") @db.VarChar(64)

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
  @@map("email_outbox")
}

// ------------------------------------------------- tracks, courses, cohorts

/// A programme area, e.g. "AI & Robotics". Data, not code: admins create them.
model Track {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String      @db.VarChar(100)
  /// Lowercase copy of the name. Its unique index forbids two tracks whose
  /// names differ only by capital letters.
  nameKey     String      @unique @map("name_key") @db.VarChar(100)
  description String?     @db.VarChar(2000)
  status      TrackStatus @default(ACTIVE)
  /// The admin who created it. Null when created by the seed command.
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy               User?                @relation("TrackCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  courses                 Course[]
  /// Applications whose "preferred track" is this one (a preference only; it grants nothing).
  preferredByApplications StudentApplication[]

  @@map("tracks")
}

/// What is taught inside a track. Weeks, lessons and blocks attach through CourseContent.
model Course {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId     String       @map("track_id") @db.Uuid
  title       String       @db.VarChar(150)
  /// Lowercase copy of the title; unique within the track.
  titleKey    String       @map("title_key") @db.VarChar(150)
  description String?      @db.VarChar(5000)
  status      CourseStatus @default(DRAFT)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  track     Track    @relation(fields: [trackId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("CourseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cohorts   Cohort[]
  /// The course's master template and each cohort's copy of it.
  contents  CourseContent[]

  @@unique([trackId, titleKey])
  @@index([trackId, status])
  @@map("courses")
}

/// One intake of students following a course over a period of time.
model Cohort {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId    String       @map("course_id") @db.Uuid
  name        String       @db.VarChar(120)
  /// Lowercase copy of the name; unique within the course.
  nameKey     String       @map("name_key") @db.VarChar(120)
  /// Calendar dates (no time of day): "runs from 3 Nov to 20 Feb".
  startsOn    DateTime     @map("starts_on") @db.Date
  endsOn      DateTime     @map("ends_on") @db.Date
  /// Maximum students (optional). Enforced when students are accepted.
  capacity    Int?
  status      CohortStatus @default(PLANNED)
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy   User?              @relation("CohortCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  instructors CohortInstructor[]
  enrollments Enrollment[]
  /// This cohort's own copy of the course content (made from the course template on first use).
  courseContent CourseContent?

  @@unique([courseId, nameKey])
  @@index([courseId, status])
  @@index([status, startsOn])
  @@map("cohorts")
}

/// Which instructor teaches which cohort. One row per pair.
/// The database refuses anyone who is not an INSTRUCTOR (see the migration).
model CohortInstructor {
  cohortId     String   @map("cohort_id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  cohort     Cohort @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  instructor User   @relation("CohortInstructorUser", fields: [instructorId], references: [id], onDelete: Restrict)
  assignedBy User?  @relation("CohortAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@id([cohortId, instructorId])
  @@index([instructorId])
  @@map("cohort_instructors")
}

// ------------------------------------------------------ student admissions

/// Personal details of a student. Kept in its OWN table, away from the login
/// data, because it is sensitive (and about minors): admin-only, never in logs,
/// never in list responses, never shown to instructors.
model StudentProfile {
  userId        String   @id @map("user_id") @db.Uuid
  dateOfBirth   DateTime @map("date_of_birth") @db.Date
  phone         String   @db.VarChar(30)
  city          String   @db.VarChar(100)
  state         String   @db.VarChar(50)
  schoolName    String   @map("school_name") @db.VarChar(200)
  gradeLevel    String   @map("grade_level") @db.VarChar(50)
  /// Guardian details: all three or none (required when the student is under 18).
  guardianName  String?  @map("guardian_name") @db.VarChar(120)
  guardianEmail String?  @map("guardian_email") @db.VarChar(254)
  guardianPhone String?  @map("guardian_phone") @db.VarChar(30)
  /// What she is interested in (short chips, at most 10). Visible only to her, her instructors and admins.
  interests     String[] @default([])
  /// Her goal for the bootcamp (280 characters at most). Same visibility as interests.
  goal          String?  @db.VarChar(280)
  /// Her "after the bootcamp" choice: a KEY from the list in the code (profile.constants.ts).
  afterBootcamp String?  @map("after_bootcamp") @db.VarChar(60)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

/// A student's application to join the programme. One per student.
model StudentApplication {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Shown to people, e.g. "GSG-2026-0391". Generated by the database.
  reference        String            @unique @default(dbgenerated("next_application_reference()")) @db.VarChar(20)
  studentId        String            @unique @map("student_id") @db.Uuid
  /// A PREFERENCE only. Access is decided by the admin (an enrollment).
  preferredTrackId String?           @map("preferred_track_id") @db.Uuid
  whyJoin          String            @map("why_join") @db.VarChar(500)
  hopeToLearn      String            @map("hope_to_learn") @db.VarChar(2000)
  stemExperience   String?           @map("stem_experience") @db.VarChar(2000)
  status           ApplicationStatus @default(PENDING)
  submittedAt      DateTime          @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedById     String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime?         @map("reviewed_at") @db.Timestamptz(3)
  /// Private note for admins. NEVER shown to the student.
  decisionNote     String?           @map("decision_note") @db.VarChar(1000)
  /// Why it was declined (internal, for reporting only). Set exactly when status = DECLINED.
  declineReason    DeclineReason?    @map("decline_reason")
  /// Optional message the admin chose to include in the decline EMAIL (declined only).
  personalNote     String?           @map("personal_note") @db.VarChar(500)
  // --- consent record: three agreements, each with its own timestamp, plus the wording version
  termsAcceptedAt   DateTime         @map("terms_accepted_at") @db.Timestamptz(3)
  privacyAcceptedAt DateTime         @map("privacy_accepted_at") @db.Timestamptz(3)
  /// Only for applicants under 18: the guardian is aware and agrees to be contacted.
  guardianConsentAt DateTime?        @map("guardian_consent_at") @db.Timestamptz(3)
  consentVersion    String           @map("consent_version") @db.VarChar(20)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student        User        @relation("ApplicationStudent", fields: [studentId], references: [id], onDelete: Restrict)
  preferredTrack Track?      @relation(fields: [preferredTrackId], references: [id], onDelete: Restrict)
  reviewedBy     User?       @relation("StudentApplicationReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  enrollment     Enrollment?

  @@index([status, submittedAt])
  @@index([preferredTrackId])
  @@map("student_applications")
}

/// "This student is in this cohort." The ONLY thing that unlocks a course.
/// A student can have at most ONE active enrollment (the database enforces it).
model Enrollment {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Shown to people, e.g. "ENR-17". Generated by the database.
  reference     String           @unique @default(dbgenerated("next_enrollment_reference()")) @db.VarChar(20)
  studentId     String           @map("student_id") @db.Uuid
  cohortId      String           @map("cohort_id") @db.Uuid
  /// The application that led to this enrollment (null for later transfers).
  applicationId String?          @unique @map("application_id") @db.Uuid
  status        EnrollmentStatus @default(ACTIVE)
  enrolledAt    DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  endedAt       DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdById   String?          @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     User                @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  cohort      Cohort              @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  application StudentApplication? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  createdBy   User?               @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  /// Her progress through the course (see LessonProgress) and the weeks opened for her (see WeekUnlock).
  lessonProgress LessonProgress[]
  weekUnlocks    WeekUnlock[]
  /// The work she sent in (see Submission).
  submissions    Submission[]
  /// Her activity log and the badges she has earned.
  activityEvents ActivityEvent[]
  badges         StudentBadge[]

  @@index([cohortId, status])
  @@index([studentId, status])
  @@map("enrollments")
}

// ------------------------------------------------------ course content (draft)

/// One EDITABLE copy of a course: either the course's master TEMPLATE (admins
/// build it; students never see it) or one COHORT's own copy, made from the
/// template the first time it is opened. This is the DRAFT (working) content;
/// publishing freezes it into numbered versions (CourseVersion).
/// The database guarantees: at most one template per course; a template has no
/// cohort and a cohort copy always has one (see the HAND-WRITTEN rules in the migration).
model CourseContent {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind                ContentKind
  courseId            String      @map("course_id") @db.Uuid
  /// Set for a cohort's own copy; empty for the course's master template.
  cohortId            String?     @unique @map("cohort_id") @db.Uuid
  /// For a cohort copy: which published template version it started from (0 = none yet).
  baseTemplateVersion Int         @default(0) @map("base_template_version")
  /// Goes up by one on every edit. The screen shows "Saved" when it changes.
  draftRevision       Int         @default(0) @map("draft_revision")
  lastEditedById      String?     @map("last_edited_by_id") @db.Uuid
  lastEditedAt        DateTime?   @map("last_edited_at") @db.Timestamptz(3)
  /// The LIVE version number (what students see). Empty = nothing published yet.
  publishedVersion    Int?        @map("published_version")
  publishedAt         DateTime?   @map("published_at") @db.Timestamptz(3)
  /// The draft revision at the moment of the last publish. If the draft revision differs now,
  /// there may be unpublished changes.
  publishedDraftRevision Int?     @map("published_draft_revision")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  course       Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  cohort       Cohort?         @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  lastEditedBy User?           @relation("ContentEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  weeks        CourseWeek[]
  versions     CourseVersion[]

  @@index([courseId])
  @@map("course_contents")
}

/// A week of a course copy. Positions are always 1, 2, 3 ... in order.
model CourseWeek {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId String   @map("content_id") @db.Uuid
  position  Int
  title     String   @db.VarChar(150)
  summary   String?  @db.VarChar(1000)
  /// For an item copied from the template: the template item it came from (used later to merge updates).
  originId  String?  @map("origin_id") @db.Uuid
  /// Goes up by one on every edit; stops two people overwriting each other.
  revision  Int      @default(1)
  /// Who last changed it (filled in by a database trigger; empty for a copy made from a template).
  editedById String? @map("edited_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  content CourseContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]
  /// At most one assignment and one live class per week (Batch 4).
  assignment   CourseAssignment?
  classSession CourseClassSession?

  @@unique([id, contentId])
  @@index([contentId, position])
  @@map("course_weeks")
}

/// A lesson inside a week. Linked to its week THROUGH the course copy, so a lesson
/// and its week can never belong to different copies.
model CourseLesson {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId        String   @map("content_id") @db.Uuid
  weekId           String   @map("week_id") @db.Uuid
  position         Int
  title            String   @db.VarChar(150)
  summary          String?  @db.VarChar(1000)
  estimatedMinutes Int?     @map("estimated_minutes")
  originId         String?  @map("origin_id") @db.Uuid
  revision         Int      @default(1)
  /// Who last changed it (filled in by a database trigger).
  editedById       String?  @map("edited_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  week   CourseWeek    @relation(fields: [weekId, contentId], references: [id, contentId], onDelete: Cascade)
  blocks LessonBlock[]

  @@unique([id, contentId])
  @@index([weekId, position])
  @@index([contentId])
  @@map("course_lessons")
}

/// One block of a lesson (text, video, activity, steps, callout or resource).
/// What it holds depends on its type; the code (block-data.ts) validates `data`.
model LessonBlock {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId      String    @map("content_id") @db.Uuid
  lessonId       String    @map("lesson_id") @db.Uuid
  position       Int
  type           BlockType
  /// true = a note for instructors only; students never see it.
  instructorOnly Boolean   @default(false) @map("instructor_only")
  data           Json
  originId       String?   @map("origin_id") @db.Uuid
  revision       Int       @default(1)
  /// Who last changed it (filled in by a database trigger).
  editedById     String?   @map("edited_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson CourseLesson @relation(fields: [lessonId, contentId], references: [id, contentId], onDelete: Cascade)

  @@index([lessonId, position])
  @@index([contentId])
  @@map("lesson_blocks")
}

// ------------------------------------------------------ course versions (published)

/// One PUBLISHED version of a course copy: a frozen snapshot of all its weeks,
/// lessons and blocks, with who published it and what changed. Versions are never
/// changed or deleted (the database refuses). The live version is the one named in
/// CourseContent.publishedVersion.
/// `publishedById` is a plain id (users are never deleted), so no User relation is needed.
model CourseVersion {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId          String        @map("content_id") @db.Uuid
  /// 1, 2, 3 ... per course copy.
  number             Int
  source             VersionSource
  /// A short description: the publisher's note, or an automatic one such as "2 lessons edited".
  summary            String        @db.VarChar(500)
  /// The whole course copy at that moment (see snapshot.ts).
  snapshot           Json
  /// A compact list of what changed compared with the version before it.
  changes            Json
  weekCount          Int           @map("week_count")
  lessonCount        Int           @map("lesson_count")
  blockCount         Int           @map("block_count")
  publishedById      String        @map("published_by_id") @db.Uuid
  /// The role that person had at the time.
  publishedByRole    Role          @map("published_by_role")
  /// For a RESTORE: the older version whose contents were made live again.
  restoredFromNumber Int?          @map("restored_from_number")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  content CourseContent @relation(fields: [contentId], references: [id], onDelete: Restrict)

  @@unique([contentId, number])
  @@map("course_versions")
}

// ------------------------------------------------------ student learning progress

/// One row per (enrollment, lesson): when the student completed the lesson, and where she paused
/// the video. Progress belongs to the ENROLLMENT, so moving to another cohort starts fresh.
/// `lessonId` is the permanent id of a lesson in a PUBLISHED course version and deliberately has no
/// link to the draft tables: restoring or discarding a draft can never delete a student's progress.
model LessonProgress {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId         String    @map("enrollment_id") @db.Uuid
  lessonId             String    @map("lesson_id") @db.Uuid
  /// Empty until she marks the lesson complete. Never overwritten once set.
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  /// The video she was last watching in this lesson, and where she paused it (seconds).
  videoBlockId         String?   @map("video_block_id") @db.Uuid
  videoPositionSeconds Int?      @map("video_position_seconds")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

/// A week that is OPEN for an enrollment: opened by her progress, or early by an instructor / admin.
/// Once a week has opened for a student it stays open, even if lessons are added to the course later.
/// `weekId` is the permanent id of a week in a PUBLISHED course version (no link to draft tables).
/// `unlockedById` is a plain id (users are never deleted), so no User relation is needed.
model WeekUnlock {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String           @map("enrollment_id") @db.Uuid
  weekId       String           @map("week_id") @db.Uuid
  source       WeekUnlockSource
  /// For an early opening: who did it, and why (both required by the database).
  unlockedById String?          @map("unlocked_by_id") @db.Uuid
  reason       String?          @db.VarChar(300)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, weekId])
  @@map("week_unlocks")
}

// ------------------------------------------------------ assignments (part of the course content)

/// A week's assignment (at most one per week): the brief, what to include, the file types allowed,
/// and the four-criterion rubric. Part of the DRAFT; frozen into every published version.
model CourseAssignment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId        String   @map("content_id") @db.Uuid
  weekId           String   @map("week_id") @db.Uuid
  title            String   @db.VarChar(150)
  /// The brief shown to students.
  brief            String   @db.VarChar(5000)
  /// The numbered "What to include" list (up to 10 items).
  includes         String[]
  successEvidence  String?  @map("success_evidence") @db.VarChar(1000)
  expectedMinutes  Int?     @map("expected_minutes")
  /// File types a student may upload (a link and a written note are always accepted).
  allowedFileTypes String[] @map("allowed_file_types")
  /// { criteria: [ { key, name, levels: [ { score, description } ] } ] } - see assignment-data.ts.
  rubric           Json
  /// Whether students can see the rubric.
  rubricVisible    Boolean  @default(true) @map("rubric_visible")
  originId         String?  @map("origin_id") @db.Uuid
  revision         Int      @default(1)
  /// Who last changed it (filled in by a database trigger).
  editedById       String?  @map("edited_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  week CourseWeek @relation(fields: [weekId, contentId], references: [id, contentId], onDelete: Cascade)

  @@unique([weekId, contentId])
  @@index([contentId])
  @@map("course_assignments")
}

/// A week's live class (at most one per week). The assignment's due date is worked out from it:
/// 3 days after class at 5:00 PM Central, with 7 more days when late work is still accepted.
model CourseClassSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contentId       String   @map("content_id") @db.Uuid
  weekId          String   @map("week_id") @db.Uuid
  /// The exact start (entered as Chicago time, stored as an instant).
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  durationMinutes Int      @map("duration_minutes")
  joinUrl         String?  @map("join_url") @db.VarChar(2000)
  notes           String?  @db.VarChar(500)
  originId        String?  @map("origin_id") @db.Uuid
  revision        Int      @default(1)
  editedById      String?  @map("edited_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  week CourseWeek @relation(fields: [weekId, contentId], references: [id, contentId], onDelete: Cascade)

  @@unique([weekId, contentId])
  @@index([contentId])
  @@map("course_class_sessions")
}

// ------------------------------------------------------ file storage and student submissions

/// An uploaded file. The bytes live in file storage under `storageKey` (a random key - never the
/// student's file name); this row records what the file is. A stored file never changes.
/// Shared: other modules (media library, shop images) can store files here too.
model StoredFile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(100)
  /// The cleaned name, for display only.
  originalName String   @map("original_name") @db.VarChar(200)
  contentType  String   @map("content_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  /// SHA-256 of the contents (to spot duplicates and prove a file was not altered).
  sha256       String   @db.Char(64)
  /// A plain id (users are never deleted), so no User relation is needed.
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submissionFiles SubmissionFile[]

  @@map("stored_files")
}

/// A student's work for one assignment (one row per enrollment + assignment). Its receipt
/// (GSG-SUB-n) is generated by the database. The versions she sent are in SubmissionVersion.
/// `assignmentId` and `weekId` are ids of items in a PUBLISHED course version (no link to draft tables).
model Submission {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Shown to people, e.g. "GSG-SUB-1042". Generated by the database.
  reference         String           @unique @default(dbgenerated("next_submission_reference()")) @db.VarChar(20)
  enrollmentId      String           @map("enrollment_id") @db.Uuid
  assignmentId      String           @map("assignment_id") @db.Uuid
  weekId            String           @map("week_id") @db.Uuid
  status            SubmissionStatus @default(SUBMITTED)
  /// While an instructor is asking for changes: the last moment the student may resubmit.
  revisionOpenUntil DateTime?        @map("revision_open_until") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  enrollment Enrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  versions   SubmissionVersion[]

  @@unique([enrollmentId, assignmentId])
  @@index([enrollmentId, status])
  @@index([assignmentId, status])
  @@map("submissions")
}

/// One version of a student's work. Once sent it is READ-ONLY: the database refuses any change.
model SubmissionVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  /// 1, 2, 3 ... (at most 25).
  number        Int
  /// The published course version she answered (later edits to the course never change it).
  courseVersion Int      @map("course_version")
  /// Sent after the due time (but before the close). Never set for a version an instructor asked for.
  isLate        Boolean  @map("is_late")
  linkUrl       String?  @map("link_url") @db.VarChar(2000)
  note          String?  @db.VarChar(2000)
  /// When it was sent.
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  files      SubmissionFile[]
  /// The instructor's review of this version (at most one).
  review     SubmissionReview?

  @@unique([submissionId, number])
  @@map("submission_versions")
}

/// Which stored files belong to which version (up to 5). Read-only once written.
model SubmissionFile {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String @map("version_id") @db.Uuid
  fileId    String @map("file_id") @db.Uuid
  /// 1 to 5.
  position  Int

  version SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  file    StoredFile        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@unique([versionId, position])
  @@unique([versionId, fileId])
  @@index([fileId])
  @@map("submission_files")
}

// ------------------------------------------------------ reviews of student submissions

/// An instructor's review of ONE version of a submission: four rubric scores (1 to 4), one strength,
/// one next step and the outcome. Its author can edit it for 24 hours (checked by the application and
/// audited); it is never deleted. `reviewerId` is a plain id (users are never deleted).
model SubmissionReview {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId       String        @map("submission_id") @db.Uuid
  versionNumber      Int           @map("version_number")
  reviewerId         String        @map("reviewer_id") @db.Uuid
  scoreUnderstanding Int           @map("score_understanding") @db.SmallInt
  scoreExecution     Int           @map("score_execution") @db.SmallInt
  scoreTesting       Int           @map("score_testing") @db.SmallInt
  scoreCommunication Int           @map("score_communication") @db.SmallInt
  /// One thing the student did well.
  strength           String        @db.VarChar(500)
  /// One thing to do next.
  nextStep           String        @map("next_step") @db.VarChar(500)
  outcome            ReviewOutcome
  /// Only for NEEDS_REVISION: days the student was given to resubmit.
  revisionDays       Int?          @map("revision_days")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Set when the author edited it (within 24 hours).
  editedAt           DateTime?     @map("edited_at") @db.Timestamptz(3)

  version SubmissionVersion @relation(fields: [submissionId, versionNumber], references: [submissionId, number], onDelete: Restrict)

  @@unique([submissionId, versionNumber])
  @@index([reviewerId, createdAt])
  @@map("submission_reviews")
}

// ------------------------------------------------------ activity log and badges

/// One thing that happened in a student's learning (she joined, completed a lesson, sent work, got a
/// review, earned a badge). APPEND-ONLY: the database refuses to change or delete a row. The activity
/// feed is read from it. (enrollmentId, type, refKey) is unique, so the same thing is never logged twice.
/// `details` holds ids and small facts only - never feedback text or scores.
model ActivityEvent {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String       @map("enrollment_id") @db.Uuid
  type         ActivityType
  /// What it is about, e.g. "lesson:<id>", "version:<id>", "review:<id>", "badge:<KEY>", "enrolled".
  refKey       String       @map("ref_key") @db.VarChar(100)
  /// When it really happened.
  occurredAt   DateTime     @map("occurred_at") @db.Timestamptz(3)
  details      Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, type, refKey])
  @@index([enrollmentId, occurredAt])
  @@map("activity_events")
}

/// A badge a student has earned, and when. Never changed or removed (the database refuses).
model StudentBadge {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  badge        BadgeKey
  earnedAt     DateTime @map("earned_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, badge])
  @@map("student_badges")
}

// ------------------------------------------------------ per-user settings

/// A person's saved settings (one row, created the first time she changes one). For now: whether
/// the profile panel is open, collapsed or closed. Works for every role.
model UserPreference {
  userId       String     @id @map("user_id") @db.Uuid
  profilePanel PanelState @default(OPEN) @map("profile_panel")
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================================================
// WEB section (owner: WEB account)
// Website editor (CMS), announcements, forms, shop, and the shared platform
// layer. Model names here start with Platform / Cms / Ann / Form / Shop so they
// can never collide with the LMS models above. Do not edit LMS models from here.
// ============================================================================

/// One row per setting that an admin changed. A setting with no row uses its
/// default (defaults live in code, next to the rule that checks the value).
model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("platform_settings")
}

/// One image in the media library. Its KEY (e.g. "people/queen-tane.jpg") never
/// changes, even when the picture is replaced, so pages never break.
model CmsMediaAsset {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// "<folder>/<n>.<ext>", lowercase. Unique and permanent.
  key               String         @unique @db.VarChar(150)
  folder            CmsMediaFolder
  title             String         @db.VarChar(120)
  originalFilename  String         @map("original_filename") @db.VarChar(200)
  contentType       String         @map("content_type") @db.VarChar(50)
  sizeBytes         Int            @map("size_bytes")
  width             Int
  height            Int
  /// Required: what a screen reader says about the picture.
  altText           String         @map("alt_text") @db.VarChar(250)
  /// When someone confirmed the people shown agreed to be published (required for PEOPLE and PROJECTS).
  consentRecordedAt DateTime?      @map("consent_recorded_at") @db.Timestamptz(3)
  /// Goes up each time the picture is replaced; it is part of the public URL so browsers fetch the new one.
  version           Int            @default(1)
  /// SHA-256 of the stored picture.
  checksum          String         @db.Char(64)
  createdById       String?        @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User?           @relation("CmsMediaCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usages    CmsMediaUsage[]
  people    CmsPerson[]
  /// Videos that use this picture as their thumbnail, and banner slides that show it.
  videoThumbnails CmsVideo[]
  bannerSlides    CmsBannerSlide[]

  @@index([folder, createdAt])
  @@map("cms_media_assets")
}

/// "This picture is used here." A picture that is in use cannot be deleted.
model CmsMediaUsage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId    String   @map("asset_id") @db.Uuid
  /// What uses it: "person", "page", "banner", "video", "product"...
  entityType String   @map("entity_type") @db.VarChar(30)
  entityId   String   @map("entity_id") @db.VarChar(64)
  /// Which part of that thing, e.g. "photo".
  field      String   @db.VarChar(60)
  /// Human label shown in the "used on" list, e.g. "Person: Queen Tane".
  label      String   @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  asset CmsMediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([assetId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@map("cms_media_usages")
}

/// A public profile on the website: a team member and/or an instructor.
/// It stays a DRAFT until it is complete (the database refuses a published
/// profile without a title and a photo).
model CmsPerson {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String           @map("full_name") @db.VarChar(120)
  title              String           @default("") @db.VarChar(120)
  subtitle           String?          @db.VarChar(120)
  kind               CmsPersonKind    @default(TEAM)
  bio                String           @default("") @db.VarChar(280)
  photoAssetId       String?          @map("photo_asset_id") @db.Uuid
  showOnAbout        Boolean          @default(true) @map("show_on_about")
  showOnCohort       Boolean          @default(false) @map("show_on_cohort")
  displayOrder       Int              @default(0) @map("display_order")
  status             CmsContentStatus @default(DRAFT)
  publishedAt        DateTime?        @map("published_at") @db.Timestamptz(3)
  /// Set when this profile belongs to an instructor account of the learning portal.
  linkedInstructorId String?          @unique @map("linked_instructor_id") @db.Uuid
  createdById        String?          @map("created_by_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  photo            CmsMediaAsset? @relation(fields: [photoAssetId], references: [id], onDelete: Restrict)
  linkedInstructor User?          @relation("CmsPersonInstructor", fields: [linkedInstructorId], references: [id], onDelete: Restrict)
  createdBy        User?          @relation("CmsPersonCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, displayOrder])
  @@map("cms_people")
}

/// A page of the public website (Home, About, Tech Bootcamp ...). It has a working
/// copy (the DRAFT) that only admins see, and numbered PUBLISHED versions. What
/// visitors see is always one frozen version, never the draft.
model CmsPage {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The address on the website, e.g. "/", "/about", "/programs/tech-bootcamp". Lowercase, unique.
  path                   String           @unique @db.VarChar(120)
  /// The name shown in the admin list (also the default page title for search engines).
  title                  String           @db.VarChar(150)
  /// The working copy: { seo: {...}, sections: [...] }. Visitors never see it.
  draft                  Json
  /// Goes up by one on every change to the draft. Stops two admins overwriting each other.
  draftRevision          Int              @default(0) @map("draft_revision")
  lastEditedById         String?          @map("last_edited_by_id") @db.Uuid
  lastEditedAt           DateTime?        @map("last_edited_at") @db.Timestamptz(3)
  /// PUBLISHED = a version is live; DRAFT = not live (never published, or taken offline).
  status                 CmsContentStatus @default(DRAFT)
  /// The LIVE version number. Empty when the page is not live.
  publishedVersion       Int?             @map("published_version")
  publishedAt            DateTime?        @map("published_at") @db.Timestamptz(3)
  /// The draft revision at the moment of the last publish. If the draft revision is higher
  /// now, the page has "draft changes" that are not live yet.
  publishedDraftRevision Int?             @map("published_draft_revision")
  createdById            String?          @map("created_by_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy    User?            @relation("CmsPageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lastEditedBy User?            @relation("CmsPageEditedBy", fields: [lastEditedById], references: [id], onDelete: Restrict)
  versions     CmsPageVersion[]

  @@index([status, updatedAt])
  @@map("cms_pages")
}

/// One PUBLISHED version of a page: a frozen snapshot of its title, search settings and
/// sections, with who published it and a short summary of what changed. Versions are never
/// changed or deleted (the database refuses), so every version stays restorable.
model CmsPageVersion {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId          String   @map("page_id") @db.Uuid
  /// 1, 2, 3 ... per page.
  number          Int
  /// What the publisher wrote ("Updated the dates"). Optional.
  note            String?  @db.VarChar(500)
  /// An automatic description such as "1 section added, 2 changed".
  summary         String   @db.VarChar(500)
  /// { title, seo, sections } exactly as published.
  snapshot        Json
  sectionCount    Int      @map("section_count")
  publishedById   String   @map("published_by_id") @db.Uuid
  /// The role that person had at the time.
  publishedByRole Role     @map("published_by_role")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  page        CmsPage @relation(fields: [pageId], references: [id], onDelete: Restrict)
  publishedBy User    @relation("CmsPageVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)

  @@unique([pageId, number])
  @@map("cms_page_versions")
}

/// A video of the Creative Studio library. It stays a DRAFT until it is complete: captions, a
/// thumbnail, a length and (when learners appear) recorded guardian consent. The database
/// refuses a published video that is missing any of them.
model CmsVideo {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Lowercase words joined by dashes; used in addresses (/studio?video=<slug>) and file names.
  slug                String           @unique @db.VarChar(80)
  title               String           @db.VarChar(120)
  source              CmsVideoSource
  /// The primary category (what the video is filed under).
  category            CmsVideoCategory
  /// Extra tags; never includes the primary category.
  alsoTagged          CmsVideoCategory[] @default([]) @map("also_tagged")
  /// A short line shown when someone hovers over the video card (120 characters at most).
  hoverDescription    String           @default("") @map("hover_description") @db.VarChar(120)
  // --- an uploaded file (source UPLOAD) ---
  fileKey             String?          @map("file_key") @db.VarChar(120)
  contentType         String?          @map("content_type") @db.VarChar(40)
  sizeBytes           Int?             @map("size_bytes")
  /// Goes up each time the file is replaced; part of the public address so browsers fetch the new one.
  fileVersion         Int              @default(1) @map("file_version")
  width               Int?
  height              Int?
  // --- an embedded video (source YOUTUBE or VIMEO): its id on that service ---
  externalId          String?          @map("external_id") @db.VarChar(60)
  durationSeconds     Int              @default(0) @map("duration_seconds")
  thumbnailAssetId    String?          @map("thumbnail_asset_id") @db.Uuid
  /// The English captions file (WebVTT text). Required to publish.
  captionsVtt         String?          @map("captions_vtt")
  captionsUpdatedAt   DateTime?        @map("captions_updated_at") @db.Timestamptz(3)
  /// The plain-text transcript. Optional.
  transcript          String?
  transcriptUpdatedAt DateTime?        @map("transcript_updated_at") @db.Timestamptz(3)
  /// True when learners appear: then guardian consent (with the date signed) is required to publish.
  showsLearners       Boolean          @default(false) @map("shows_learners")
  /// Learners shown as first name + last initial only, e.g. "Ada O.".
  peopleInVideo       String[]         @default([]) @map("people_in_video")
  consentSignedOn     DateTime?        @map("consent_signed_on") @db.Date
  showOnHome          Boolean          @default(false) @map("show_on_home")
  showOnStudio        Boolean          @default(true) @map("show_on_studio")
  showOnShowcase      Boolean          @default(false) @map("show_on_showcase")
  featured            Boolean          @default(false)
  /// Position among the videos of the same primary category (0 = first).
  displayOrder        Int              @default(0) @map("display_order")
  status              CmsContentStatus @default(DRAFT)
  postedOn            DateTime?        @map("posted_on") @db.Date
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(3)
  createdById         String?          @map("created_by_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  thumbnail    CmsMediaAsset?   @relation(fields: [thumbnailAssetId], references: [id], onDelete: Restrict)
  createdBy    User?            @relation("CmsVideoCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  bannerSlides CmsBannerSlide[]

  @@index([status, category, displayOrder])
  @@index([status, featured])
  @@map("cms_videos")
}

/// One slide of a page banner. It can appear on several pages (see CmsBannerSlidePlacement),
/// shows a photo or a muted looping video, is LIVE only when published and inside its schedule.
model CmsBannerSlide {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// A short title (2 to 4 words works best).
  title        String             @db.VarChar(60)
  tagline      String             @default("") @db.VarChar(160)
  mediaType    CmsBannerMediaType @map("media_type")
  /// The photo - or, for a video slide, the picture shown until the video loads and to visitors
  /// who asked their device for reduced motion.
  imageAssetId String             @map("image_asset_id") @db.Uuid
  videoId      String?            @map("video_id") @db.Uuid
  /// PUBLISHED = Live; DRAFT = not shown.
  status       CmsContentStatus   @default(DRAFT)
  /// Optional schedule: shown only from "startsAt" and until "endsAt".
  startsAt     DateTime?          @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime?          @map("ends_at") @db.Timestamptz(3)
  createdById  String?            @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  image      CmsMediaAsset             @relation(fields: [imageAssetId], references: [id], onDelete: Restrict)
  video      CmsVideo?                 @relation(fields: [videoId], references: [id], onDelete: Restrict)
  createdBy  User?                     @relation("CmsBannerSlideCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  placements CmsBannerSlidePlacement[]

  @@index([status])
  @@map("cms_banner_slides")
}

/// "This slide is shown on this page, at this position." Each page has its own order.
model CmsBannerSlidePlacement {
  slideId  String        @map("slide_id") @db.Uuid
  page     CmsBannerPage
  /// 0 = first.
  position Int           @default(0)

  slide CmsBannerSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)

  @@id([slideId, page])
  @@index([page, position])
  @@map("cms_banner_slide_placements")
}

/// One item in a person's notification bell. `type` + `payload` say WHAT happened; the wording
/// is built from them when the list is read (see notification.types.ts), so a change of wording
/// applies to old notifications too. Never holds a password, a link token or private feedback.
model PlatformNotification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  /// e.g. "week.opened". Lowercase letters, digits, dots and underscores.
  type        String    @db.VarChar(60)
  payload     Json      @default("{}")
  /// Stops the same event notifying the same person twice (empty = no such guard).
  dedupeKey   String?   @map("dedupe_key") @db.VarChar(120)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Empty = unread.
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)

  recipient User @relation("PlatformNotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt, createdAt(sort: Desc)])
  @@map("platform_notifications")
}

/// A short update for a learning group (a cohort, a track, or every running cohort). Written by an
/// admin or an instructor; students only read it. No replies, comments or reactions.
/// `trackId` and `cohortId` are plain ids (tracks and cohorts are archived or closed, never deleted).
model AnnAnnouncement {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String          @db.VarChar(120)
  /// Plain text, up to 1500 characters.
  message      String          @db.VarChar(1500)
  audienceType AnnAudienceType @map("audience_type")
  trackId      String?         @map("track_id") @db.Uuid
  cohortId     String?         @map("cohort_id") @db.Uuid
  status       AnnStatus       @default(DRAFT)
  authorId     String          @map("author_id") @db.Uuid
  /// The role the author had when writing it.
  authorRole   Role            @map("author_role")
  /// When it went live (empty while a draft).
  publishedAt  DateTime?       @map("published_at") @db.Timestamptz(3)
  /// When its text was last changed AFTER it was published (students see "Edited ...").
  editedAt     DateTime?       @map("edited_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  author User @relation("AnnAnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc)])
  @@index([cohortId])
  @@index([trackId])
  @@index([authorId])
  @@map("ann_announcements")
}

/// A message sent through the public Contact, Volunteer or Partner form. Personal data: only
/// admins can read it. `payload` holds the form's fields exactly as validated.
model FormSubmission {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          FormSubmissionType
  status        FormSubmissionStatus @default(NEW)
  senderName    String               @map("sender_name") @db.VarChar(160)
  /// Always lowercase.
  senderEmail   String               @map("sender_email") @db.VarChar(254)
  payload       Json
  /// The first words of the message, for the admin list.
  summary       String               @db.VarChar(200)
  /// The inbox the team copy was emailed to (empty when none is set up yet).
  routedTo      String?              @map("routed_to") @db.VarChar(254)
  /// A fingerprint of type + email + message, to ignore an accidental double send.
  contentHash   String               @map("content_hash") @db.Char(64)
  handledById   String?              @map("handled_by_id") @db.Uuid
  handledAt     DateTime?            @map("handled_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  handledBy User? @relation("FormSubmissionHandledBy", fields: [handledById], references: [id], onDelete: Restrict)

  @@index([type, status, createdAt(sort: Desc)])
  @@index([contentHash, createdAt])
  @@map("form_submissions")
}

/// Someone who asked to be emailed when applications open (the closed-bootcamp "Notify me" form).
/// The unsubscribe link in each email is signed, so no secret is stored here.
model FormNotifyMeSignup {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Always lowercase; one row per address.
  email          String             @unique @db.VarChar(254)
  /// The "I am a..." answer.
  roleLabel      String             @map("role_label") @db.VarChar(60)
  /// A track name, or "Not sure yet".
  interestedIn   String             @map("interested_in") @db.VarChar(100)
  /// Ticked by someone under 18: their parent or guardian knows they are signing up.
  guardianKnows  Boolean            @default(false) @map("guardian_knows")
  status         FormNotifyMeStatus @default(SUBSCRIBED)
  subscribedAt   DateTime           @default(now()) @map("subscribed_at") @db.Timestamptz(3)
  unsubscribedAt DateTime?          @map("unsubscribed_at") @db.Timestamptz(3)
  /// The last time the "applications are open" email was queued for this address.
  lastNotifiedAt DateTime?          @map("last_notified_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("form_notify_me_signups")
}